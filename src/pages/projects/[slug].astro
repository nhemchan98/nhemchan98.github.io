---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.title.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"") },
    props: { project }
  }));
}
const { project } = Astro.props;
---
<Layout title={`${project.title} — Nhem Chan`} description={project.description}>
  <main class="mx-auto min-h-screen max-w-5xl px-4 py-28">
    <a href="/#work" class="text-sm text-slate-500 hover:text-white">← Back to work</a>
    <div class="mt-10 overflow-hidden rounded-3xl border border-white/10"><img src={project.image} alt={project.title} class="w-full" /></div>
    <div class="mt-10"><p class="font-mono text-xs uppercase tracking-[.25em] text-blue-400">{project.number} / Project</p><h1 class="mt-4 font-display text-5xl font-bold text-white sm:text-7xl">{project.title}</h1><p class="mt-7 max-w-3xl text-lg leading-8 text-slate-400">{project.description}</p><div class="mt-7 flex flex-wrap gap-2">{project.tags.map(tag => <span class="rounded-lg border border-white/10 bg-white/[.03] px-3 py-1.5 text-xs text-slate-400">{tag}</span>)}</div><a href={project.href} target="_blank" rel="noreferrer" class="mt-9 inline-flex rounded-xl bg-white px-5 py-3 text-sm font-bold text-slate-950">Open project ↗</a></div>
  </main>
</Layout>