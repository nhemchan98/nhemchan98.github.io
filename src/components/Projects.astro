---
import { projects } from "../data/projects";
---
<section id="work" class="scroll-mt-28 border-y border-white/5 bg-white/[.015] py-28">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><p class="font-mono text-xs uppercase tracking-[.25em] text-blue-400">02 / Selected work</p><h2 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">Things I've built.</h2></div><a href="https://github.com/nhemchan98?tab=repositories" target="_blank" rel="noreferrer" class="text-sm font-semibold text-slate-400 hover:text-white">View all repositories ↗</a></div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {projects.map((project) => {
        const slug = project.title.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");
        return <article class="project-card card group overflow-hidden rounded-3xl transition duration-500 hover:-translate-y-1">
          <a href={`/projects/${slug}`} class="block">
            <div class="relative aspect-[16/9] overflow-hidden bg-[#0b101a]">
              <img src={project.image} alt={project.title} class="project-image h-full w-full object-cover" loading="lazy"/>
              <div class="project-overlay absolute inset-0 grid place-items-center bg-blue-950/20 backdrop-blur-[1px]"><span class="rounded-full border border-white/15 bg-black/40 px-4 py-2 text-xs font-semibold text-white backdrop-blur-md">View project →</span></div>
            </div>
          </a>
          <div class="p-7 md:p-8">
            <div class="flex items-start justify-between"><span class="font-mono text-xs text-blue-400">{project.number}</span><a href={project.href} target="_blank" rel="noreferrer" class="text-slate-600 hover:text-blue-400">GitHub ↗</a></div>
            <h3 class="mt-5 font-display text-2xl font-semibold text-white">{project.title}</h3>
            <p class="mt-3 min-h-20 text-sm leading-7 text-slate-400">{project.description}</p>
            <div class="mt-6 flex flex-wrap gap-2">{project.tags.map(tag => <span class="rounded-lg border border-white/5 bg-white/[.03] px-2.5 py-1 text-[11px] text-slate-400">{tag}</span>)}</div>
          </div>
        </article>;
      })}
    </div>
  </div>
</section>