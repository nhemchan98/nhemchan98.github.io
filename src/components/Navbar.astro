<header class="fixed inset-x-0 top-0 z-50">
  <div class="mx-auto mt-3 max-w-6xl px-3 sm:mt-4 sm:px-4">
    <nav class="card flex items-center justify-between rounded-2xl px-3 py-3 sm:px-4">
      <a href="#top" class="font-display text-lg font-bold tracking-tight"><span class="text-white">NHEM</span><span class="text-blue-400">.</span></a>
      <div class="hidden items-center gap-7 text-sm text-slate-400 md:flex">
        <a class="nav-link transition hover:text-white" href="#work">Work</a><a class="nav-link transition hover:text-white" href="#about">About</a><a class="nav-link transition hover:text-white" href="#stack">Stack</a><a class="nav-link transition hover:text-white" href="#contact">Contact</a>
      </div>
      <div class="flex items-center gap-2">
        <a href="https://github.com/nhemchan98" target="_blank" rel="noreferrer" class="hidden rounded-xl border border-white/10 px-3 py-2 text-xs font-semibold text-slate-200 transition hover:border-blue-400/40 hover:bg-blue-400/10 sm:block">GitHub ↗</a>
        <button id="menuBtn" aria-label="Open menu" aria-expanded="false" class="rounded-xl border border-white/10 px-3 py-2 text-slate-300 md:hidden">☰</button>
      </div>
    </nav>
    <div id="mobileMenu" class="card mt-2 hidden rounded-2xl p-3 md:hidden">
      <a class="block rounded-xl px-4 py-3 text-sm text-slate-300 hover:bg-white/5" href="#work">Work</a>
      <a class="block rounded-xl px-4 py-3 text-sm text-slate-300 hover:bg-white/5" href="#about">About</a>
      <a class="block rounded-xl px-4 py-3 text-sm text-slate-300 hover:bg-white/5" href="#stack">Stack</a>
      <a class="block rounded-xl px-4 py-3 text-sm text-slate-300 hover:bg-white/5" href="#contact">Contact</a>
    </div>
  </div>
</header>
<script>
const btn=document.getElementById("menuBtn"),menu=document.getElementById("mobileMenu");
btn?.addEventListener("click",()=>{const open=menu?.classList.toggle("hidden")===false;btn.setAttribute("aria-expanded",String(open));});
menu?.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>menu.classList.add("hidden")));
</script>