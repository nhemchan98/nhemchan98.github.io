---
import { techGroups } from "../data/tech";
---
<section id="stack" class="scroll-mt-28 py-28">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mb-12"><p class="font-mono text-xs uppercase tracking-[.25em] text-blue-400">03 / Toolkit</p><h2 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">Tools I use to build.</h2><p class="mt-4 max-w-2xl text-sm leading-7 text-slate-500">A practical stack across web development, AI, automation, databases and live production.</p></div>
    <div class="space-y-10">
      {techGroups.map((group) => (
        <div>
          <h3 class="mb-4 text-sm font-semibold text-slate-300">{group.title}</h3>
          <div class="flex flex-wrap gap-3">
            {group.items.map(([name, icon, color]) => (
              <div class="icon-tile card flex items-center gap-3 rounded-2xl px-4 py-3" title={name}>
                <div class="grid h-9 w-9 place-items-center rounded-xl bg-white/[.04]">
                  <img src={`https://cdn.simpleicons.org/${icon}/${color.replace("#","")}`} alt="" class="h-5 w-5" loading="lazy" />
                </div>
                <span class="text-sm font-medium text-slate-300">{name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>